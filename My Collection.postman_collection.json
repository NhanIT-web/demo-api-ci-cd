              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Kiểm tra tên khách hàng khớp với dữ liệu từ file CSV\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\n    if (pm.response.code === 200) {\n        var jsonData = pm.response.json();\n        var expectedFirstName = pm.iterationData.get(\"firstname\");\n        pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\n    } else {\n        pm.expect.fail(\"Cannot validate booking data because response status is \" + pm.response.code);\n    }\n});\n\n// Lưu lại bookingid vào môi trường nếu thành công\nif (pm.response.code === 200) {\n    var jsonData = pm.response.json();\n    pm.environment.set(\"bookingid\", jsonData.bookingid);\n}"
                ]
              }
            }
