                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tạo booking thành công (Status 200)\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Kiểm tra tên khách hàng khớp với dữ liệu từ file CSV\npm.test(\"Tên khách hàng khớp với dữ liệu đầu vào\", function () {\n    var jsonData = pm.response.json();\n    var expectedFirstName = pm.iterationData.get(\"firstname\") || pm.iterationData.get(\"\\ufefffirstname\");\n    pm.expect(jsonData.booking.firstname).to.eql(expectedFirstName);\n});\n\n// Lưu lại bookingid vào môi trường\nvar jsonData = pm.response.json();\npm.environment.set(\"bookingid\", jsonData.bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"{{firstname}}\",\n    \"lastname\": \"{{lastname}}\",\n    \"totalprice\": {{totalprice}},\n    \"depositpaid\": {{depositpaid}},\n    \"bookingdates\": {\n        \"checkin\": \"{{checkin}}\",\n        \"checkout\": \"{{checkout}}\"\n    },\n    \"additionalneeds\": \"{{additionalneeds}}\"\n}",
